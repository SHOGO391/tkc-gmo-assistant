{
  "name": "tkc-gmo-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "demo": "tsx src/cli.ts demo",
    "cli": "tsx src/cli.ts",
    "backup": "tsx src/cli.ts backup",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "csv-parse": "7.0.3",
    "express": "5.2.1",
    "iconv-lite": "0.7.3",
    "playwright": "1.64.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "25.3.0",
    "tsx": "4.21.0",
    "typescript": "7.0.2"
  }
}
